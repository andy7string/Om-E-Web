{
  "framework": "xcom",
  "scan_strategy": "generic",
  "url_patterns": [
    "x.com",
    "*.x.com"
  ],
  "focus_targets": [
    "textarea[placeholder='Ask anything']",
    "textarea[placeholder*='Post']",
    "div[contenteditable='true'][role='textbox']",
    "textarea",
    "input[type='text']"
  ],
  "forceIncludeSelectors": [
    "textarea[placeholder='Ask anything']",
    "textarea[placeholder*='Post']",
    "div[contenteditable='true'][role='textbox']",
    "div[data-testid='tweetTextarea_0']"
  ],
  "selectors": {
    "navigation": [
      "nav:not([hidden])",
      "[role='navigation']",
      "header[role='banner']"
    ],
    "buttons": [
      "button",
      "[role='button']",
      "div[role='button']",
      "[data-testid*='button']",
      "[data-testid='sendButton']"
    ],
    "menus": [
      "[role='menu']",
      "[role='menuitem']",
      "div[aria-haspopup='menu']"
    ],
    "hidden_content": [
      "[aria-hidden='true']",
      "[data-state='closed']"
    ],
    "text_inputs": [
      "textarea[placeholder='Ask anything']:not([disabled]):not([aria-disabled='true'])",
      "textarea[placeholder*='Post']:not([disabled]):not([aria-disabled='true'])",
      "div[contenteditable='true'][role='textbox']:not([disabled]):not([aria-disabled='true'])",
      "div[data-testid='tweetTextarea_0']:not([disabled]):not([aria-disabled='true'])",
      "textarea:not([disabled]):not([aria-disabled='true'])",
      "input[type='text']:not([disabled]):not([aria-disabled='true'])",
      "input[type='search']:not([disabled]):not([aria-disabled='true'])"
    ],
    "content_elements": [
      "main article",
      "main section",
      "div[role='feed']",
      "div[data-testid='cellInnerDiv']"
    ],
    "url_elements": [
      "a[href]",
      "[data-url]"
    ]
  },
  "inputPatterns": {
    "tweetCompose": {
      "description": "X/Twitter post compose box",
      "container": "div[contenteditable='true'][role='textbox'], div[data-testid='tweetTextarea_0']",
      "forceBubbles": true,
      "forceSubmitSelector": true,
      "submitSelector": "[data-testid='tweetButtonInline'], button[data-testid='tweetButton']"
    }
  }
}
