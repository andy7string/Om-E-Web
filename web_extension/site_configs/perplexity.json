{
  "framework": "generic",
  "scan_strategy": "universal",
  "url_patterns": [
    "perplexity.ai",
    "*.perplexity.ai"
  ],
  "focus_targets": [
    "div#ask-input[contenteditable='true']",
    "[role='textbox'][data-lexical-editor]",
    "div[data-lexical-editor='true'][aria-placeholder]"
  ],
  "selectors": {
    "navigation": [
      "nav",
      "[role='navigation']",
      "header"
    ],
    "buttons": [
      "button",
      "[role='button']",
      "div[role='button']"
    ],
    "menus": [
      "[role='menu']",
      "[role='menuitem']",
      "div[aria-haspopup='menu']"
    ],
    "hidden_content": [
      "[aria-hidden='true']",
      "[hidden]"
    ],
    "text_inputs": [
      "div#ask-input[contenteditable='true']",
      "[role='textbox'][data-lexical-editor]",
      "div[data-lexical-editor='true'][aria-placeholder]"
    ],
    "content_elements": [
      "main article",
      "main section",
      "div[role='feed']",
      "div[role='listitem']"
    ],
    "url_elements": [
      "a[href]",
      "[data-url]",
      "[data-href]"
    ]
  },
  "filters": {
    "include": [
      "div#ask-input",
      "[role='textbox'][data-lexical-editor]",
      "a[href]",
      "[data-url]",
      "[data-href]"
    ],
    "exclude": [
      "[aria-hidden='true']",
      "[hidden]"
    ]
  }
}
