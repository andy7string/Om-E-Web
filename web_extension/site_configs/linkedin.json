{
  "framework": "linkedin",
  "scan_strategy": "generic",
  "url_patterns": [
    "linkedin.com",
    "*.linkedin.com"
  ],
  "focus_targets": [
    "input[data-testid='typeahead-input']",
    "input[componentkey='jobSearchBox']",
    "input[aria-label*='Search']",
    "input[type='search']"
  ],
  "forceIncludeSelectors": [
    "input[data-testid='typeahead-input']",
    "input[componentkey='jobSearchBox']",
    "input[aria-label*='Search']",
    "button[aria-label*='Search']"
  ],
  "selectors": {
    "navigation": [
      "nav:not([hidden])",
      "[role='navigation']",
      "header[role='banner']"
    ],
    "buttons": [
      "button",
      "[role='button']",
      "div[role='button']"
    ],
    "text_inputs": [
      "input[data-testid='typeahead-input']",
      "input[type='text']",
      "input[type='search']",
      "textarea"
    ]
  },
  "inputPatterns": {
    "jobSearch": {
      "description": "LinkedIn job search input",
      "container": "[componentkey='jobSearchBox']",
      "forceBubbles": true,
      "injectReactEnter": true,
      "_comment": "React ignores synthetic Enter - inject page script to call React onKeyDown directly"
    },
    "globalSearch": {
      "description": "LinkedIn global search input (all pages)",
      "container": "[data-testid='typeahead-input'], [data-view-name='search-global-typeahead-input'], input[aria-label='Search']",
      "forceBubbles": true,
      "injectReactEnter": true,
      "_comment": "React ignores synthetic Enter - uses SW chrome.scripting.executeScript to call React props directly"
    }
  }
}
