{
  "framework": "chatgpt",
  "scan_strategy": "generic",
  "url_patterns": [
    "chatgpt.com",
    "*.chatgpt.com"
  ],
  "focus_targets": [
    "div[contenteditable='true'][data-placeholder]",
    "div[contenteditable='true'][role='textbox']",
    "textarea",
    "input[type='text']"
  ],
  "forceIncludeSelectors": [
    "#prompt-textarea",
    "div.ProseMirror[contenteditable='true']",
    "textarea[name='prompt-textarea']",
    "div[contenteditable='true'][role='textbox']"
  ],
  "selectors": {
    "navigation": [
      "nav:not([hidden])",
      "[role='navigation']",
      "header[role='banner']"
    ],
    "buttons": [
      "button",
      "[role='button']",
      "div[role='button']",
      "[data-testid*='button']"
    ],
    "menus": [
      "[role='menu']",
      "[role='menuitem']",
      "div[aria-haspopup='menu']"
    ],
    "hidden_content": [
      "[aria-hidden='true']",
      "[data-state='closed']"
    ],
    "text_inputs": [
      "div[contenteditable='true']",
      "textarea",
      "input[type='text']",
      "input[type='search']",
      "input:not([type]):not([disabled]):not([aria-disabled='true'])",
      "input[role='combobox']:not([disabled]):not([aria-disabled='true'])",
      "input[aria-label]:not([type='hidden']):not([type='submit']):not([type='button']):not([disabled]):not([aria-disabled='true'])"
    ],
    "content_elements": [
      "main article",
      "main section",
      "div[role='feed']",
      "div[role='listitem']"
    ],
    "url_elements": [
      "a[href]",
      "[data-url]"
    ]
  }
}
