{
  "framework": "chatgpt",
  "scan_strategy": "generic",
  "url_patterns": [
    "chatgpt.com",
    "*.chatgpt.com"
  ],
  "capabilities": {
    "setInput": {
      "action": "SetInputValue",
      "label": "Set ChatGPT prompt text",
      "description": "Type into the ChatGPT prompt input (ProseMirror contenteditable). Use this capability instead of direct AT textbox setValue for reliable input on ChatGPT.",
      "url_pattern": "chatgpt.com",
      "params": {
        "value": "string (the text to type)",
        "submit": "boolean (optional, send message after typing)"
      },
      "usage": "{\"type\": \"execute_capability\", \"action\": \"SetInputValue\", \"params\": {\"value\": \"Hello ChatGPT\", \"submit\": true}}",
      "selectors": [
        "#prompt-textarea",
        "div.ProseMirror[contenteditable='true']",
        "div[contenteditable='true'][data-placeholder]",
        "textarea[name='prompt-textarea']"
      ],
      "submitMethod": "enter",
      "autoSubmit": true
    }
  },
  "focus_targets": [
    "div[contenteditable='true'][data-placeholder]",
    "div[contenteditable='true'][role='textbox']",
    "textarea",
    "input[type='text']"
  ],
  "forceIncludeSelectors": [
    "#prompt-textarea",
    "div.ProseMirror[contenteditable='true']",
    "textarea[name='prompt-textarea']",
    "div[contenteditable='true'][role='textbox']"
  ],
  "selectors": {
    "navigation": [
      "nav:not([hidden])",
      "[role='navigation']",
      "header[role='banner']"
    ],
    "buttons": [
      "button",
      "[role='button']",
      "div[role='button']",
      "[data-testid*='button']"
    ],
    "menus": [
      "[role='menu']",
      "[role='menuitem']",
      "div[aria-haspopup='menu']"
    ],
    "hidden_content": [
      "[aria-hidden='true']",
      "[data-state='closed']"
    ],
    "text_inputs": [
      "div[contenteditable='true']",
      "textarea",
      "input[type='text']",
      "input[type='search']",
      "input:not([type]):not([disabled]):not([aria-disabled='true'])",
      "input[role='combobox']:not([disabled]):not([aria-disabled='true'])",
      "input[aria-label]:not([type='hidden']):not([type='submit']):not([type='button']):not([disabled]):not([aria-disabled='true'])"
    ],
    "content_elements": [
      "main article",
      "main section",
      "div[role='feed']",
      "div[role='listitem']"
    ],
    "url_elements": [
      "a[href]",
      "[data-url]"
    ]
  }
}
