{
  "framework": "facebook",
  "scan_strategy": "generic",
  "url_patterns": [
    "facebook.com",
    "*.facebook.com"
  ],
  "focus_targets": [
    "#email",
    "#pass",
    "input[name='email']",
    "input[name='pass']",
    "input[placeholder='Search Marketplace']",
    "input[aria-label='Search Marketplace']",
    "input[aria-label='Search Facebook']",
    "input[type='search']"
  ],
  "forceIncludeSelectors": [
    "#email",
    "#pass",
    "input[type='email']",
    "input[type='password']",
    "input[type='search']",
    "button[name='login']",
    "button[data-testid='royal-login-button']"
  ],
  "exclude_text": [
    "Press Enter to send"
  ],
  "exclude": [
    "div[role='textbox'][contenteditable='true'][aria-label='Message'][data-lexical-editor='true']",
    "div[role='textbox'][contenteditable='true'][aria-label='Message']",
    "[role='textbox'][contenteditable='true'][aria-label='Message']",
    "[data-lexical-editor='true'][role='textbox'][aria-label='Message']",
    "div[role='button'][aria-label='Press Enter to send']",
    "[role='button'][aria-label='Press Enter to send']"
  ],
  "selectors": {
    "navigation": [
      "nav:not([hidden])",
      "[role='navigation']",
      "header[role='banner']",
      "[role='menubar']"
    ],
    "buttons": [
      "button",
      "[role='button']",
      "div[role='button']",
      "[aria-label*='button' i]"
    ],
    "menus": [
      "[role='menu']",
      "[role='menuitem']",
      "[aria-haspopup='menu']"
    ],
    "hidden_content": [
      "[aria-hidden='true']",
      "[data-hidden='true']"
    ],
    "text_inputs": [
      "#email",
      "#pass",
      "input[type='email']",
      "input[type='password']",
      "input[type='text']",
      "input[type='search']",
      "textarea",
      "[contenteditable='true']"
    ],
    "content_elements": [
      "main",
      "[role='main']",
      "[role='article']",
      "[role='region']",
      "[data-pagelet]"
    ],
    "url_elements": [
      "a[href]",
      "[data-url]"
    ],
    "marketplace": [
      "[aria-label*='Details']",
      "[aria-label*='Condition']",
      "[aria-label*='Location']",
      "[aria-label*='map' i]",
      "[aria-label*='See all']",
      "[aria-label*='Message']",
      "[aria-label*='Save']",
      "[aria-label*='Share']",
      "span[dir='auto']"
    ]
  },
  "capabilities": {
    "sendMessage": {
      "action": "SendMessage",
      "label": "Send message to seller",
      "description": "Click the Message button on a Marketplace listing",
      "url_pattern": "/marketplace/item/",
      "selectors": [
        "[aria-label='Message']",
        "[aria-label*='Message' i]",
        "div[role='button'][aria-label*='Message' i]"
      ]
    },
    "messengerSendMessage": {
      "action": "MessengerSendMessage",
      "label": "Send a Messenger message",
      "description": "Type into the Messenger composer and send (FB Lexical editor edge case)",
      "url_pattern": "facebook.com",
      "requires_selectors": [
        "div[role='textbox'][contenteditable='true'][aria-label='Message'][data-lexical-editor='true']",
        "div[role='textbox'][contenteditable='true'][aria-label='Message']",
        "[data-lexical-editor='true'][role='textbox'][aria-label='Message']"
      ],
      "params": {
        "value": "string"
      },
      "autoSubmit": true,
      "forceLexicalInput": true,
      "selectors": [
        "div[role='textbox'][contenteditable='true'][aria-label='Message']",
        "div[contenteditable='true'][role='textbox'][aria-label='Message']",
        "[data-lexical-editor='true'][role='textbox'][aria-label='Message']",
        "[role='textbox'][contenteditable='true'][aria-label*='Message' i]"
      ],
      "submitMethod": "enter_then_click",
      "submitSelector": "div[role='button'][aria-label='Press Enter to send'], [role='button'][aria-label='Press Enter to send'], div[role='button'][aria-label='Send'], [role='button'][aria-label='Send'], button[type='submit']",
      "avoidSubmitKeywords": ["voice", "microphone", "mic", "call", "video", "camera"],
      "allowSubmitKeywords": ["press enter to send", "send"]
    },
    "saveItem": {
      "action": "SaveItem",
      "label": "Save Marketplace listing",
      "description": "Save/bookmark a Marketplace item",
      "url_pattern": "/marketplace/item/",
      "selectors": [
        "[aria-label='Save']",
        "[aria-label*='Save' i]",
        "div[role='button'][aria-label*='Save' i]"
      ]
    },
    "openMap": {
      "action": "OpenMap",
      "label": "Open location map",
      "description": "Open the map showing item location",
      "url_pattern": "/marketplace/item/",
      "selectors": [
        "[aria-label*='map' i]",
        "[aria-label*='location' i]",
        "a[href*='maps']"
      ]
    }
  },
  "inputPatterns": {
    "marketplaceSearch": {
      "description": "Facebook Marketplace search input",
      "container": "input[aria-label='Search Marketplace'], input[type='search'][placeholder*='Marketplace' i]",
      "forceBubbles": true,
      "useAutocompleteDropdown": true,
      "autocompleteConfig": {
        "containerSelectors": ["[role='listbox']", "ul[role='listbox']"],
        "optionSelectors": ["[role='option']", "li[role='option']"],
        "maxWait": 5000
      },
      "_comment": "Uses MutationObserver to detect dropdown and click first option - event-driven, no delays"
    },
    "globalSearch": {
      "description": "Facebook global search input",
      "container": "input[aria-label='Search Facebook']",
      "forceBubbles": true,
      "useAutocompleteDropdown": true,
      "autocompleteConfig": {
        "containerSelectors": ["[role='listbox']", "ul[role='listbox']"],
        "optionSelectors": ["[role='option']", "li[role='option']"],
        "maxWait": 5000
      },
      "_comment": "Uses MutationObserver to detect dropdown and click first option - event-driven, no delays"
    },
    "messengerChat": {
      "description": "Facebook Messenger chat input (React/Lexical contenteditable)",
      "container": "[aria-label='Message'], [aria-label*='Message' i][contenteditable='true'], [role='textbox'][aria-label*='Message' i]",
      "placeholder": "[aria-label='Message'], [aria-label*='Message' i][contenteditable='true'], [role='textbox'][aria-label*='Message' i]",
      "forceBubbles": true,
      "forceSubmitSelector": true,
      "submitSelector": "[aria-label='Press Enter to send'], [aria-label*='send' i], button[type='submit']",
      "_comment": "React contenteditable ignores synthetic Enter - use submitSelector to click send button directly"
    }
  }
}
