{
  "framework": "generic",
  "scan_strategy": "universal",
  "url_patterns": [
    "facebook.com",
    "*.facebook.com"
  ],
  "focus_targets": [
    "#email",
    "#pass",
    "input[name='email']",
    "input[name='pass']",
    "input[data-testid='royal-email']",
    "input[data-testid='royal-pass']",
    "input[placeholder='Search Marketplace']",
    "input[aria-label='Search Marketplace']",
    "input[aria-label='Search Facebook']",
    "input[type='search'][role='combobox']",
    "input[type='search'][aria-label*='Search' i]"
  ],
  "selectors": {
    "text_inputs": [
      "#email:not([aria-hidden='true'])",
      "#pass:not([aria-hidden='true'])",
      "input[name='email']:not([aria-hidden='true'])",
      "input[name='pass']:not([aria-hidden='true'])",
      "input[data-testid='royal-email']:not([aria-hidden='true'])",
      "input[data-testid='royal-pass']:not([aria-hidden='true'])",
      "input[type='email']:not([aria-hidden='true'])",
      "input[type='password']:not([aria-hidden='true'])",
      "input[type='search']:not([aria-hidden='true'])",
      "input[type='search'][role='combobox']:not([aria-hidden='true'])",
      "input[type='search'][aria-label*='Search' i]:not([aria-hidden='true'])",
      "input[placeholder*='Search' i]:not([aria-hidden='true'])",
      "input[aria-label*='Search' i]:not([aria-hidden='true'])",
      "input[aria-label='Search Facebook']:not([aria-hidden='true'])",
      "input[aria-label='Search Marketplace']:not([aria-hidden='true'])",
      "[role='search'] input[type='search']:not([aria-hidden='true'])",
      "[role='combobox'][type='search']:not([aria-hidden='true'])",
      "textarea:not([aria-hidden='true'])",
      "[contenteditable='true']:not([aria-hidden='true'])"
    ],
    "buttons": [
      "button[name='login']:not([aria-hidden='true'])",
      "button[data-testid='royal-login-button']:not([aria-hidden='true'])",
      "button[type='submit']:not([aria-hidden='true'])",
      "input[type='submit']:not([aria-hidden='true'])",
      "button[aria-label*='Search' i]:not([aria-hidden='true'])",
      "button[aria-label*='Submit' i]:not([aria-hidden='true'])"
    ]
  },
  "filters": {
    "include": [
      "#email",
      "#pass",
      "input[name='email']",
      "input[name='pass']",
      "input[data-testid='royal-email']",
      "input[data-testid='royal-pass']",
      "input[type='email']",
      "input[type='password']",
      "input[type='search']",
      "input[type='search'][role='combobox']",
      "input[placeholder*='Search' i]",
      "input[aria-label*='Search' i]",
      "input[aria-label='Search Marketplace']",
      "input[aria-label='Search Facebook']",
      "input[placeholder='Search Marketplace']",
      "input[placeholder='Search Facebook']",
      "button[name='login']",
      "button[data-testid='royal-login-button']"
    ],
    "exclude": [
      "[aria-hidden='true']",
      "div.x1i10hfl:not(input)"
    ]
  },
  "forceIncludeSelectors": [
    "#email",
    "#pass",
    "input[name='email']",
    "input[name='pass']",
    "input[data-testid='royal-email']",
    "input[data-testid='royal-pass']",
    "input[type='email']",
    "input[type='password']",
    "input[type='search']",
    "input[type='search'][role='combobox']",
    "input[placeholder='Search Marketplace']",
    "input[aria-label='Search Marketplace']",
    "input[placeholder='Search Facebook']",
    "input[aria-label='Search Facebook']",
    "input[placeholder*='Search' i]",
    "input[aria-label*='Search' i]",
    "button[name='login']",
    "button[data-testid='royal-login-button']"
  ],
  "extraInteractiveSelectors": [
    "button[name='login']",
    "button[data-testid='royal-login-button']",
    "button[aria-label*='search' i]",
    "button[type='submit']",
    "input[type='submit']"
  ]
}
