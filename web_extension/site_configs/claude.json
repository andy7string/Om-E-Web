{
  "framework": "claude",
  "scan_strategy": "generic",
  "url_patterns": [
    "claude.ai",
    "*.claude.ai"
  ],
  "focus_targets": [
    "div[contenteditable='true'][data-testid='chat-input']",
    "div[contenteditable='true'][role='textbox']",
    "div.tiptap.ProseMirror[contenteditable='true']",
    "textarea",
    "input[type='text']"
  ],
  "selectors": {
    "navigation": [
      "nav:not([hidden])",
      "[role='navigation']",
      "header[role='banner']"
    ],
    "buttons": [
      "button",
      "[role='button']",
      "div[role='button']",
      "[data-testid*='button']"
    ],
    "menus": [
      "[role='menu']",
      "[role='menuitem']",
      "div[aria-haspopup='menu']"
    ],
    "hidden_content": [
      "[aria-hidden='true']",
      "[data-state='closed']"
    ],
    "text_inputs": [
      "div[contenteditable='true'][data-testid='chat-input']:not([disabled]):not([aria-disabled='true']):not([hidden])",
      "div[contenteditable='true'][role='textbox']:not([disabled]):not([aria-disabled='true']):not([hidden])",
      "div.tiptap.ProseMirror[contenteditable='true']:not([disabled]):not([aria-disabled='true']):not([hidden])",
      "div[contenteditable='true']:not([disabled]):not([aria-disabled='true']):not([hidden])",
      "[role='textbox']:not([disabled]):not([aria-disabled='true']):not([hidden])",
      "textarea:not([disabled]):not([aria-disabled='true']):not([hidden])",
      "input[type='text']:not([disabled]):not([aria-disabled='true']):not([hidden])",
      "input[type='search']:not([disabled]):not([aria-disabled='true']):not([hidden])"
    ],
    "content_elements": [
      "main article",
      "main section",
      "div[role='feed']",
      "div[role='listitem']"
    ],
    "url_elements": [
      "a[href]",
      "[data-url]"
    ]
  },
  "forceIncludeSelectors": [
    "div[contenteditable='true'][data-testid='chat-input']",
    "div[contenteditable='true'][role='textbox']",
    "div.tiptap.ProseMirror[contenteditable='true']"
  ]
}
