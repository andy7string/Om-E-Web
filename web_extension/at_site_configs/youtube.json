{
  "_comment": "YouTube-specific AT scanning config - filters noisy repetitive elements",
  "extends": "default",

  "exclude_names": [
    "HIDE PROMPT",
    "HUD",
    "Scroll to top",
    "Drag to scroll",
    "Scroll to bottom",
    "Send message",
    "Ask me anything...",
    "Copy to clipboard",
    "More actions",
    "Action menu",
    "Go to channel",
    "tooltip",
    "Avatar image",
    "Skip navigation",
    "Shorts - More actions",
    "Search with your voice",
    "Guide",
    "Next",
    "Previous",
    "Expand",
    "Collapse",
    "Mute",
    "Unmute",
    "Full screen",
    "Exit full screen",
    "Theater mode",
    "Default view",
    "Miniplayer",
    "Settings",
    "Subtitles/closed captions",
    "Autoplay is on",
    "Autoplay is off",
    "Seek slider",
    "Volume slider",
    "Chapters",
    "Ambient mode",
    "Annotations",
    "Picture-in-picture",
    "Watch on TV",
    "Cinema mode",
    "Queue",
    "Add to queue",
    "Dislike this video",
    "I dislike this",
    "Share",
    "Clip",
    "Download",
    "Thanks",
    "Save",
    "Report",
    "Not interested",
    "Don't recommend channel"
  ],

  "exclude_name_patterns": [
    "^\\+$",
    "^−$",
    "^ome-",
    "Om_E",
    "^\\d+ (second|minute|hour|day|week|month|year)s? ago$",
    "^\\d+:\\d+$",
    "^\\d+:\\d+:\\d+$",
    "^\\d+ views?$",
    "^\\d+[KMB]? views?$",
    "^\\d+[KMB]? subscribers?$",
    "^\\d+[KMB]?$",
    "^Verified$",
    "^Live$",
    "^NEW$",
    "^LIVE$",
    "^Watched$",
    "^\\d+ watching$",
    "^\\d+[KMB]? watching$",
    "^Streamed \\d+",
    "^Premiered \\d+",
    "^\\d+%$",
    "^Show (more|less)$",
    "^See (more|less)$",
    "^Read more$",
    "^\\.\\.\\.$"
  ],

  "exclude_roles": [
    "none",
    "presentation",
    "generic",
    "paragraph",
    "LineBreak",
    "InlineTextBox",
    "StaticText",
    "tooltip",
    "image"
  ],

  "priority_roles": [
    "search",
    "navigation",
    "main",
    "heading",
    "link",
    "button"
  ],

  "always_include_roles": ["search", "searchbox", "combobox"],

  "label_overrides": {
    "combobox:Search": "YouTube Video Search"
  },

  "capabilities": {
    "transcript": {
      "action": "RetrieveTranscript",
      "label": "Get video transcript",
      "description": "Retrieves the full transcript for this YouTube video",
      "url_pattern": "/watch?v=",
      "params": {},
      "usage": "{\"type\": \"execute_capability\", \"action\": \"RetrieveTranscript\", \"params\": {}}"
    },
    "playPause": {
      "action": "TogglePlayPause",
      "label": "Toggle video playback",
      "description": "Toggles play/pause state of the video player",
      "url_pattern": "/watch?v=",
      "params": {},
      "usage": "{\"type\": \"execute_capability\", \"action\": \"TogglePlayPause\", \"params\": {}}"
    },
    "like": {
      "action": "LikeVideo",
      "label": "Like this video",
      "description": "Likes the current YouTube video",
      "url_pattern": "/watch?v=",
      "params": {},
      "usage": "{\"type\": \"execute_capability\", \"action\": \"LikeVideo\", \"params\": {}}"
    }
  },

  "video_page": {
    "url_pattern": "/watch?v=",
    "focus_selectors": [
      "video",
      "#movie_player",
      "#description",
      "#comments"
    ]
  },

  "max_depth": 15,
  "max_nodes": 2000
}
