    "ReloadLLMConfig": {
      "group": "config",
      "action": "ReloadLLMConfig",
      "label": "Reload LLM config",
      "description": "Reloads the server-side LLM agent config from disk",
      "synonyms": ["refresh config", "reload settings", "apply config changes"],
      "example": "{\"cap\": \"ReloadLLMConfig\"}",
      "params": {}
    },
    "AddLLMProvider": {
      "group": "config",
      "action": "AddLLMProvider",
      "label": "Add new LLM provider",
      "description": "Adds a new provider configuration",
      "synonyms": ["new provider", "add ai provider", "configure new llm"],
