    "GetChatList": {
      "internal": true,
      "group": "chat",
      "action": "GetChatList",
      "label": "Get chat list data (internal)",
      "description": "Returns JSON array of chats with id, title, date_short, message_count. Internal/programmatic use - for UI display use ShowChats instead.",
      "synonyms": ["get chat list", "fetch chats", "retrieve chat list", "chat list data"],
      "example": "{\"cap\": \"GetChatList\"}",
      "params": {
        "project_id": "Optional - filter by project (use 'default' for unassigned)"
      }
    },
    "LoadChat": {
      "group": "chat",
      "action": "LoadChat",
      "label": "Load a chat by ID",
      "description": "Returns full chat content including all messages",
      "synonyms": ["open chat", "load conversation", "get chat", "retrieve chat"],
      "example": "{\"cap\": \"LoadChat\", \"params\": {\"chat_id\": \"chat-abc123\"}}",
      "params": {
        "chat_id": "Required - the chat ID to load"
      }
    },
    "CreateChat": {
      "group": "chat",
      "action": "CreateChat",
      "label": "Create a new chat",
