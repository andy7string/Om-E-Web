      "synonyms": ["add message", "save message", "append to chat"],
      "example": "{\"cap\": \"AppendMessage\", \"params\": {\"chat_id\": \"chat-abc\", \"role\": \"user\", \"content\": \"Hello\"}}",
      "params": {
        "chat_id": "Chat ID (null to create new chat)",
        "role": "Message role: user or assistant",
        "content": "Message content",
        "title": "Optional - title for new chat",
        "page_url": "Optional - page URL for new chat metadata",
        "page_title": "Optional - page title for new chat metadata"
      }
    },
