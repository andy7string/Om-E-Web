      "synonyms": ["hide chats", "close chats", "hide my chats", "close conversations", "close those chats", "close the chats", "hide the chats", "close chat panel", "close sidebar", "hide sidebar", "close the sidebar"],
      "example": "{\"cap\": \"HideChats\"}",
