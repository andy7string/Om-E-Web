      "synonyms": ["show chats", "show my chats", "show me my chats", "see my chats", "view chats", "view my chats", "my chats", "where are my chats", "open chats", "show conversations", "show past chats", "where are the conversations", "my conversations", "where are conversations", "past conversations", "conversation history", "chat history", "show history", "list chats", "list my chats", "get my chats", "what chats do I have"],
      "example": "{\"cap\": \"ShowChats\"}",
