      "synonyms": ["new chat", "start conversation", "new conversation", "fresh chat"],
      "example": "{\"cap\": \"CreateChat\", \"params\": {\"title\": \"My Chat\"}}",
      "params": {
        "title": "Optional - title for the chat",
        "page_url": "Optional - page URL for metadata",
        "page_title": "Optional - page title for metadata"
      }
    },
    "AppendMessage": {
      "group": "chat",
      "action": "AppendMessage",
      "label": "Append a message to a chat",
