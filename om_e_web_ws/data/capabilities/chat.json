{
  "group": "chat",
  "description": "Chat management capabilities",
  "capabilities": {
    "AppendUserMessage": {
      "label": "Add a user message to chat history",
      "example": "{\"cap\": \"AppendUserMessage\", \"params\": {\"content\": \"...\"}}",
      "handler": "server"
    },
    "AppendAssistantMessage": {
      "label": "Add an assistant message to chat history",
      "example": "{\"cap\": \"AppendAssistantMessage\", \"params\": {\"content\": \"...\"}}",
      "handler": "server"
    },
    "ListChats": {
      "label": "List all saved conversations",
      "example": "{\"cap\": \"ListChats\"}",
      "handler": "server"
    },
    "CreateChat": {
      "label": "Start a new conversation",
      "example": "{\"cap\": \"CreateChat\"}",
      "handler": "server"
    },
    "LoadChat": {
      "label": "Load / open a saved conversation",
      "example": "{\"cap\": \"LoadChat\", \"params\": {\"chat_id\": \"...\"}}",
      "handler": "server"
    },
    "GetFullHistory": {
      "label": "Get complete chat history for context",
      "example": "{\"cap\": \"GetFullHistory\"}",
      "handler": "server"
    },
    "RenameChat": {
      "label": "Rename a conversation",
      "example": "{\"cap\": \"RenameChat\", \"params\": {\"chat_id\": \"...\", \"title\": \"...\"}}",
      "handler": "server"
    },
    "DeleteChat": {
      "label": "Delete a conversation",
      "example": "{\"cap\": \"DeleteChat\", \"params\": {\"chat_id\": \"...\"}}",
      "handler": "server"
    },
    "GetCurrentChat": {
      "label": "Get the current active chat ID",
      "example": "{\"cap\": \"GetCurrentChat\"}",
      "handler": "server"
    },
    "SetCurrentChat": {
      "label": "Switch to a different conversation",
      "example": "{\"cap\": \"SetCurrentChat\", \"params\": {\"chat_id\": \"...\"}}",
      "handler": "server"
    },
    "SearchChats": {
      "label": "Search conversations by content",
      "example": "{\"cap\": \"SearchChats\", \"params\": {\"query\": \"...\"}}",
      "handler": "server"
    }
  }
}
