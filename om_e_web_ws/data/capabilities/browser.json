{
  "group": "browser",
  "description": "Chrome browser control capabilities",
  "capabilities": {
    "ScrollDown": {
      "label": "Scroll down the page",
      "example": "{\"cap\": \"ScrollDown\"}",
      "handler": "extension"
    },
    "ScrollUp": {
      "label": "Scroll up the page",
      "example": "{\"cap\": \"ScrollUp\"}",
      "handler": "extension"
    },
    "ScrollTop": {
      "label": "Go to top of page",
      "example": "{\"cap\": \"ScrollTop\"}",
      "handler": "extension"
    },
    "ScrollBottom": {
      "label": "Go to bottom of page",
      "example": "{\"cap\": \"ScrollBottom\"}",
      "handler": "extension"
    },
    "ZoomIn": {
      "label": "Zoom in / make bigger",
      "example": "{\"cap\": \"ZoomIn\"}",
      "handler": "extension"
    },
    "ZoomOut": {
      "label": "Zoom out / make smaller",
      "example": "{\"cap\": \"ZoomOut\"}",
      "handler": "extension"
    },
    "ZoomReset": {
      "label": "Reset zoom to 100%",
      "example": "{\"cap\": \"ZoomReset\"}",
      "handler": "extension"
    },
    "OpenTab": {
      "label": "Open new tab (optionally with URL)",
      "example": "{\"cap\": \"OpenTab\", \"params\": {\"url\": \"https://...\"}}",
      "handler": "extension"
    },
    "CloseTab": {
      "label": "Close a browser tab",
      "example": "{\"cap\": \"CloseTab\", \"params\": {\"tabId\": 123}}",
      "handler": "extension"
    },
    "SwitchTab": {
      "label": "Switch to another tab",
      "example": "{\"cap\": \"SwitchTab\", \"params\": {\"tabId\": 123}}",
      "handler": "extension"
    },
    "GoBack": {
      "label": "Go back in browser history",
      "example": "{\"cap\": \"GoBack\"}",
      "handler": "extension"
    },
    "GoForward": {
      "label": "Go forward in browser history",
      "example": "{\"cap\": \"GoForward\"}",
      "handler": "extension"
    },
    "Refresh": {
      "label": "Refresh / reload the page",
      "example": "{\"cap\": \"Refresh\"}",
      "handler": "extension"
    }
  }
}
