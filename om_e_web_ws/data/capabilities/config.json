{
  "group": "config",
  "description": "LLM and system configuration capabilities",
  "capabilities": {
    "GetLLMConfig": {
      "label": "Get current LLM settings / what model am I using",
      "example": "{\"cap\": \"GetLLMConfig\"}",
      "handler": "server"
    },
    "SetLLMProvider": {
      "label": "Switch LLM provider (openai, anthropic, lm_studio)",
      "example": "{\"cap\": \"SetLLMProvider\", \"params\": {\"provider\": \"openai\"}}",
      "handler": "server"
    },
    "SetLLMEndpoint": {
      "label": "Set LLM API endpoint URL",
      "example": "{\"cap\": \"SetLLMEndpoint\", \"params\": {\"provider\": \"...\", \"endpoint\": \"...\"}}",
      "handler": "server"
    },
    "SetLLMModel": {
      "label": "Change LLM model",
      "example": "{\"cap\": \"SetLLMModel\", \"params\": {\"model\": \"gpt-4\"}}",
      "handler": "server"
    },
    "SetLLMAPIKey": {
      "label": "Set API key for a provider",
      "example": "{\"cap\": \"SetLLMAPIKey\", \"params\": {\"provider\": \"...\", \"api_key\": \"...\"}}",
      "handler": "server"
    },
    "SetTemperature": {
      "label": "Adjust LLM temperature (0.0 to 2.0)",
      "example": "{\"cap\": \"SetTemperature\", \"params\": {\"temperature\": 0.7}}",
      "handler": "server"
    },
    "SetMaxTokens": {
      "label": "Set maximum response tokens",
      "example": "{\"cap\": \"SetMaxTokens\", \"params\": {\"max_tokens\": 1000}}",
      "handler": "server"
    },
    "AddLLMProvider": {
      "label": "Add a new LLM provider",
      "example": "{\"cap\": \"AddLLMProvider\", \"params\": {\"key\": \"...\", \"name\": \"...\", \"type\": \"...\", \"endpoint\": \"...\", \"model\": \"...\"}}",
      "handler": "server"
    },
    "RemoveLLMProvider": {
      "label": "Remove an LLM provider",
      "example": "{\"cap\": \"RemoveLLMProvider\", \"params\": {\"provider\": \"...\"}}",
      "handler": "server"
    },
    "ListCapabilities": {
      "label": "List all available capabilities",
      "example": "{\"cap\": \"ListCapabilities\"}",
      "handler": "server"
    }
  }
}
