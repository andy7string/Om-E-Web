{
  "group": "hud",
  "description": "HUD interface control capabilities",
  "capabilities": {
    "TypeInPrompt": {
      "label": "Type text into the chat input",
      "example": "{\"cap\": \"TypeInPrompt\", \"params\": {\"text\": \"...\"}}",
      "handler": "extension"
    },
    "ClearPrompt": {
      "label": "Clear the chat input field",
      "example": "{\"cap\": \"ClearPrompt\"}",
      "handler": "extension"
    },
    "SubmitPrompt": {
      "label": "Submit / send the current message",
      "example": "{\"cap\": \"SubmitPrompt\"}",
      "handler": "extension"
    },
    "DisplayMessage": {
      "label": "Display a message in chat",
      "example": "{\"cap\": \"DisplayMessage\", \"params\": {\"content\": \"...\"}}",
      "handler": "extension"
    },
    "ToggleHUD": {
      "label": "Show or hide the HUD panel",
      "example": "{\"cap\": \"ToggleHUD\"}",
      "handler": "extension"
    },
    "MinimizeHUD": {
      "label": "Minimize / hide / collapse the chat panel",
      "example": "{\"cap\": \"MinimizeHUD\"}",
      "handler": "extension"
    },
    "MaximizeHUD": {
      "label": "Maximize / expand / show the chat panel",
      "example": "{\"cap\": \"MaximizeHUD\"}",
      "handler": "extension"
    },
    "SetTheme": {
      "label": "Change the theme (robot, kawaii, atom)",
      "example": "{\"cap\": \"SetTheme\", \"params\": {\"theme\": \"robot\"}}",
      "handler": "extension"
    },
    "ListThemes": {
      "label": "List available themes",
      "example": "{\"cap\": \"ListThemes\"}",
      "handler": "extension"
    }
  }
}
